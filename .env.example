# Copy to .env and fill in.  .env is gitignored — it is the ONLY place the
# credential form is chosen, which is why the profiles never mention one.
JAATO_PROFILE_SET=openrouter_haiku

# The profiles interpolate ${JAATO_OPENROUTER_API_KEY} and nothing else, so
# a public checkout needs no resolver plugin.  Either form works here:
#
#   plain value    JAATO_OPENROUTER_API_KEY=sk-or-...
#   secret URI     JAATO_OPENROUTER_API_KEY=pass://jaato/openrouter/api-key
#
# The daemon resolves secret URIs (pass:// / vault:// / awssm:// / sops:// /
# keyring://) in .env VALUES before the runner is spawned.  Those resolvers
# ship out of tree (jaato-premium), so the URI form must never appear in a
# committed file — see certify/facade_guard.py::check_publishable.
JAATO_OPENROUTER_API_KEY=
